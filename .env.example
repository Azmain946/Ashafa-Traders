# Copy to .env for local development (PostgreSQL required — SQLite is not used).

# Django
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_TIME_ZONE=Asia/Dhaka

# PostgreSQL (pick one style)
# Railway injects DATABASE_URL automatically when you add a Postgres plugin.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pharmacy

# Or discrete variables (used if DATABASE_URL is empty):
# PGHOST=localhost
# PGPORT=5432
# PGUSER=postgres
# PGPASSWORD=postgres
# PGDATABASE=pharmacy

# Set DATABASE_SSL=0 for local Postgres without SSL
DATABASE_SSL=0

# Production / Railway (set in Railway service variables)
# DJANGO_DEBUG=0
# DJANGO_SECRET_KEY=<generate-a-strong-key>
# CSRF_TRUSTED_ORIGINS=https://your-app.up.railway.app
# DATABASE_URL=<from Railway Postgres plugin>
